# syntax=docker/dockerfile:1.7

# Stage 1: Build Go + Cgo (libsqlite3) air-read-engine binary
FROM golang:1.26-bookworm AS builder
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc libc6-dev libsqlite3-dev pkg-config \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download
COPY cmd/ ./cmd/
COPY internal/ ./internal/
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=1 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/air-read-engine ./cmd/air-read-engine

# Stage 2: Minimal runtime image for air-read-engine
FROM debian:bookworm-slim
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates libsqlite3-0 gosu \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --no-create-home --uid 10002 airread \
    && mkdir -p /var/lib/air-read-engine/cache \
    && chown -R airread:airread /var/lib/air-read-engine

COPY --from=builder /out/air-read-engine /usr/local/bin/air-read-engine
COPY scripts/read-engine-entrypoint.sh /usr/local/bin/read-engine-entrypoint.sh
RUN chmod +x /usr/local/bin/read-engine-entrypoint.sh

ENV AIR_READ_ENGINE_DATA_DIR=/var/lib/air-read-engine \
    AIR_READ_ENGINE_CACHE_DIR=/var/lib/air-read-engine/cache \
    AIR_READ_ENGINE_LISTEN_HOST=0.0.0.0 \
    AIR_READ_ENGINE_PG_PORT=5433 \
    AIR_READ_ENGINE_GRPC_ADDR=0.0.0.0:9092

EXPOSE 5433 9092
ENTRYPOINT ["/usr/local/bin/read-engine-entrypoint.sh"]
