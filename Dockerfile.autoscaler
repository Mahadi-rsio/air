# syntax=docker/dockerfile:1.7

# Stage 1: Build standalone Go air-autoscaler binary
FROM golang:1.26-bookworm AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download
COPY cmd/ ./cmd/
COPY internal/ ./internal/
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/air-autoscaler ./cmd/air-autoscaler

# Stage 2: Minimal runtime image for air-autoscaler
FROM debian:bookworm-slim
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates gosu \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --no-create-home --uid 10004 airauto \
    && mkdir -p /var/lib/air-autoscaler \
    && chown -R airauto:airauto /var/lib/air-autoscaler

COPY --from=builder /out/air-autoscaler /usr/local/bin/air-autoscaler
COPY scripts/autoscaler-entrypoint.sh /usr/local/bin/autoscaler-entrypoint.sh
RUN chmod +x /usr/local/bin/autoscaler-entrypoint.sh

ENV AUTOSCALER_STATE_DIR=/var/lib/air-autoscaler \
    AUTOSCALER_HTTP_ADDR=[::]:8080

EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/autoscaler-entrypoint.sh"]
